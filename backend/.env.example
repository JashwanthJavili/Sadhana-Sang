# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line (Render: Environment → FIREBASE_SERVICE_ACCOUNT).
FIREBASE_SERVICE_ACCOUNT=
# Or, locally, a path to the downloaded file instead:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_DATABASE_URL=https://sadhanatracker-92f04-default-rtdb.firebaseio.com
# Any long random string; the cron URL must send it
CRON_SECRET=
ALLOWED_ORIGINS=*
REMINDER_HOUR=7
