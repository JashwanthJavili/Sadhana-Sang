      ]
    },
    "adminNotifications": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com')",
      ".write": "auth != null",
      ".indexOn": [
        "timestamp",
        "type",
        "read"
      ]
    },
    "userNotifications": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null",
        ".indexOn": [
          "timestamp",
          "read"
        ]
      }
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com')",
      ".indexOn": [
        "timestamp",
        "type"
      ]
    },
    "broadcasts": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com')",
      ".indexOn": [
        "timestamp"
      ]
    },
    "connectionRequests": {
      ".read": "auth != null",
      ".indexOn": [
        "fromUserId",
        "toUserId",
        "status",
        "timestamp"
      ],
      "$requestId": {
        ".write": "auth != null && ((!data.exists() && newData.child('fromUserId').val() == auth.uid && !root.child('blocks').child(newData.child('toUserId').val()).child(auth.uid).exists() && root.child('users').child(newData.child('toUserId').val()).child('settings/requestsFrom').val() != 'nobody' && (root.child('users').child(newData.child('toUserId').val()).child('settings/requestsFrom').val() != 'same-gender' || root.child('users').child(newData.child('toUserId').val()).child('settings/gender').val() == root.child('users').child(auth.uid).child('settings/gender').val())) || (data.exists() && (data.child('fromUserId').val() == auth.uid || data.child('toUserId').val() == auth.uid)))"
      }
    },
    "connections": {
      "$userId": {
        ".read": "auth != null",
        "$connectedUserId": {
          ".write": "auth != null && (auth.uid == $userId || auth.uid == $connectedUserId)"
        }
      }
    },
    "userProfiles": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && auth.uid == $userId",
        ".indexOn": [
          "isOnline",
          "lastSeen"
        ]
      }
    },
    "chatMessages": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com')"
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid == $uid || (root.child('chats').child($chatId).child('participants/0').val() == auth.uid || root.child('chats').child($chatId).child('participants/1').val() == auth.uid))"
        }
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com'))",
        ".validate": "!newData.exists() || (newData.child('uid').val() == $uid && newData.child('userName').isString())"
      }
    },
    "circleProfiles": {
      "$gender": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('settings/gender').val() == $gender",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && (!newData.exists() || newData.child('gender').val() == $gender)"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "pushSubscribers": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'jashwanthjavili7@gmail.com')",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "pushQueue": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('from').val() == auth.uid",
        ".validate": "newData.hasChildren(['type','from','at']) && newData.child('type').val().matches(/^(message|request|accepted)$/)"
      }
    },
    "serverState": {
      ".read": "false",
      ".write": "false"
    }
  }
}